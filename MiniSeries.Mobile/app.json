{
  "expo": {
    "name": "MiniSeries",
    "slug": "miniseries-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/project-logo-v2.png",
    "scheme": "miniseriesmobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/project-logo-v2.png",
      "bundleIdentifier": "com.miniseries.app"
    },
    "android": {
      "package": "com.miniseries.app",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/images/project-logo-v2.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/project-logo-v2.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#09090b",
          "image": "./assets/images/project-logo-v2.png",
          "imageWidth": 160,
          "resizeMode": "contain"
        }
      ],
      "expo-font",
      "expo-web-browser",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.126955656491-vddeqf0bguj9g5gpah91m5u9sl3d0bbu"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "agpVersion": "8.7.2"
          }
        }
      ],
      [
        "./plugins/withApkName.js",
        {
          "fileName": "MiniSeries"
        }
      ],
      "expo-video"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "7afad071-dd1d-4cdc-ad40-96f29eeed426"
      }
    }
  }
}
